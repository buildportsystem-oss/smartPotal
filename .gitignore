# .gitignore 파일 내용
# 이곳에 적힌 파일이나 폴더는 깃허브에 업로드되지 않습니다.

# 의존성 폴더 (설치된 라이브러리들 - 용량이 커서 올리지 않습니다)
node_modules/
frontend/node_modules/

# 빌드된 결과물 (나중에 다시 생성할 수 있습니다)
dist/
build/
frontend/dist/

# 환경 변수 파일 (비밀번호, DB 접속 정보 등 민감한 정보 - 절대 올리면 안 됩니다!)
.env
.env.*

# 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 운영체제 파일
.DS_Store
Thumbs.db
